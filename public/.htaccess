Options -Indexes

RewriteEngine On

# Redirect HTTP → HTTPS (bỏ comment khi deploy production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cho phép truy cập trực tiếp file tĩnh (css, js, images, fonts)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tất cả request còn lại → index.php (Front Controller)
RewriteRule ^(.*)$ index.php [QSA,L]

# Bảo mật: chặn truy cập file nhạy cảm
<FilesMatch "\.(env|log|sql|sh|bak|conf)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Charset mặc định
AddDefaultCharset UTF-8

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

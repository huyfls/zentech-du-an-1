    "CONNECT":    {"title": "Kiểu kết nối ưa thích", "type": "single", "labels": {"1": "Có dây", "2": "Bluetooth", "3": "Không dây 2.4GHz", "4": "Đa chế độ (có dây, Bluetooth, 2.4GHz)"}},
